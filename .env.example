# Copy to .env (never commit .env).

# Where your plants are: used for rain/frost (Open-Meteo) and for the climate Claude plans for.
PLANTS_LAT=53.35
PLANTS_LON=-6.26
PLANTS_PLACE=Ireland
TZ=Europe/Dublin

# Optional Home Assistant notifications. Leave HA_TOKEN empty to run without HA.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_NOTIFY=mobile_app_your_phone
# The address your phone opens the page on (used for links and the notification picture).
PLANTS_PUBLIC_URL=http://localhost:8772
PLANTS_NOTIFY_AT=09:30
PLANTS_NOTIFY_EVERY_DAYS=2

# Optional: host folder for plant_photo(path=...), see docker-compose.yml.
# PLANTS_HOST_ROOT=/host
# PLANTS_HOST_PREFIX=C:\Users\me\Pictures
